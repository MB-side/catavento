{
  "name": "catavento",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build:data": "tsx scripts/build-data.ts",
    "ingest": "tsx scripts/ingest.ts",
    "build": "pnpm build:data && next build && pnpm share-images && pnpm check:content",
    "serve": "tsx scripts/serve-out.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "tsx scripts/content-guard.ts",
    "check:links": "tsx scripts/check-links.ts",
    "format:check": "prettier --check .",
    "share-images": "tsx scripts/share-images.tsx"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "fast-xml-parser": "^5.11.2",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "robots-parser": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
